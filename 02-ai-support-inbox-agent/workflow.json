      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#support-escalations",
          "mode": "name"
        },
        "text": "=Needs a human: *{{ $('New Support Email').item.json.subject }}*\nDraft: {{ $json.output.reply }}",
        "otherOptions": {}
      },
      "id": "af6fb8d4-d876-4987-9cd1-38dd32924a98",
