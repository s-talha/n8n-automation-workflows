{
  "name": "B2B Lead Enrichment Pipeline",
  "nodes": [
    {
      "parameters": {
        "content": "## B2B Lead Enrichment Pipeline\nEvery weekday morning it enriches new target accounts, scores them against your ICP and pushes only qualified, de duplicated contacts to HubSpot.\n\nA daily summary goes to the sales channel.",
        "height": 180,
        "width": 480
      },
      "id": "454cc7fb-75a7-4800-b090-092e81e88ce5",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -170
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 7 * * 1-5"
            }
          ]
        }
      },
      "id": "2aa9749b-10a8-42ba-9cae-d05198d438dd",
      "name": "Weekdays 07:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        240
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "Target Accounts"
        },
        "sheetName": {
          "__rl": true,
          "value": "gid=0",
          "mode": "list",
          "cachedResultName": "New"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "status",
              "lookupValue": "new"
            }
          ]
        },
        "options": {}
      },
      "id": "7a5fe62c-bd8d-4b40-9a6f-eb4d66a36f19",
      "name": "Read Target Accounts",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        240,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apollo.io/api/v1/mixed_people/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { q_organization_domains: $json.domain, person_titles: ['Head of Sales', 'VP Sales', 'Founder'], per_page: 5 } }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 1000
            }
          }
        }
      },
      "id": "af02d9ca-9a7f-4774-9a76-7e2398b27392",
      "name": "Find Decision Makers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        240
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "people",
        "options": {}
      },
      "id": "62a4ba16-c6c8-4afe-8324-82bd03b1a15c",
      "name": "Split People",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        720,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Simple, explainable ICP score (0 to 100)\nconst seniority = { founder: 30, c_suite: 30, vp: 25, head: 20, director: 15 };\nreturn $input.all().map(({ json: p }) => {\n  let score = seniority[p.seniority] ?? 5;\n  if (p.organization?.estimated_num_employees >= 50) score += 25;\n  if (['SE', 'NO', 'DK', 'FI'].includes(p.country_code)) score += 20;\n  if (p.email_status === 'verified') score += 25;\n  return { json: { ...p, icp_score: Math.min(score, 100) } };\n});"
      },
      "id": "58815cac-2225-4f01-aafe-15dc52bb67b0",
      "name": "Score Against ICP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "20b39ca9-a5c7-4665-ad16-64951bc1b925",
              "leftValue": "={{ $json.icp_score }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "rightValue": 60
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2a7236c5-e2db-4295-ad82-445747197795",
      "name": "Score 60 or Higher",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        240,
        520
      ]
    },
    {
      "parameters": {
        "compare": "selectedFields",
        "fieldsToCompare": "email",
        "options": {}
      },
      "id": "bce38cca-ce20-4268-8b5d-2010ad0c3392",
      "name": "Remove Duplicates",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 1.1,
      "position": [
        480,
        520
      ]
    },
    {
      "parameters": {
        "email": "={{ $json.email }}",
        "additionalFields": {
          "firstName": "={{ $json.first_name }}",
          "lastName": "={{ $json.last_name }}",
          "jobTitle": "={{ $json.title }}",
          "companyName": "={{ $json.organization.name }}"
        }
      },
      "id": "a6fd0b8c-a640-4d79-8195-186c71e205b5",
      "name": "Create Contacts",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.1,
      "position": [
        720,
        520
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "contacts",
        "options": {}
      },
      "id": "70c0056d-6c91-4fe9-97a0-a71000f73b1a",
      "name": "Count Results",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        960,
        520
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#sales",
          "mode": "name"
        },
        "text": "=:sunrise: {{ $json.contacts.length }} new qualified contacts added to HubSpot today.",
        "otherOptions": {}
      },
      "id": "66783d36-0c93-4836-a861-0d1376629be0",
      "name": "Daily Summary",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        1200,
        520
      ]
    }
  ],
